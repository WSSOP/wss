{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxingdu.local/schemas/planetary-jewelry/assessment-input-v1.json",
  "title": "Planetary Jewelry Assessment Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "assessment_mode", "user_id", "chart", "answers", "versions"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_mode": {"enum": ["SELF_ASSESSMENT", "GIFT_BLESSING"]},
    "user_id": {"type": "string", "minLength": 1},
    "chart": {
      "type": "object",
      "additionalProperties": true,
      "required": ["chart_id", "chart_snapshot_id", "subject_name", "birth_time_quality", "ascendant_stable", "data_quality", "calculation_version", "d1", "shadbala", "dasha"],
      "properties": {
        "chart_id": {"type": "string", "minLength": 1},
        "chart_snapshot_id": {"type": "string", "minLength": 1},
        "subject_name": {"type": "string", "minLength": 1},
        "subject_relation": {"type": ["string", "null"]},
        "birth_time_quality": {"enum": ["RECTIFIED", "DOCUMENTED", "DECLARED_EXACT", "APPROXIMATE", "UNKNOWN_STABILITY", "NO_TIME"]},
        "ascendant_stable": {"type": ["boolean", "null"]},
        "data_quality": {"enum": ["FULL_CHART", "PARTIAL_CHART", "INSUFFICIENT_CHART"]},
        "calculation_version": {"type": "string"},
        "d1": {"type": "object"},
        "d9": {"type": ["object", "null"]},
        "shadbala": {"type": "object"},
        "dasha": {"type": "object"}
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "option_ids"],
        "properties": {
          "question_id": {"type": "string"},
          "option_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionnaire_version", "ruleset_version", "renderer_version", "catalog_contract_version"],
      "properties": {
        "questionnaire_version": {"const": "PJ_QUESTIONNAIRE_V1"},
        "ruleset_version": {"const": "PJ_RULESET_V1"},
        "renderer_version": {"const": "PJ_RENDERER_V1"},
        "catalog_contract_version": {"const": "PJ_CATALOG_V1"}
      }
    }
  }
}
